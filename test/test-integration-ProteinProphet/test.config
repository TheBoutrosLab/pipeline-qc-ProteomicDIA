includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR is not set; configure it in .env')
}
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'DIA_QC_NFTEST'
    mzml_csv = "${projectDir}/test/test-integration-ProteinProphet/mzml.csv"
    search_idxml_csv = "${projectDir}/test/test-integration-ProteinProphet/search.csv"
    filtered_idxml_csv = "${projectDir}/test/test-integration-ProteinProphet/filtered.csv"
    psm_features_csv = "${projectDir}/test/test-integration-ProteinProphet/features.csv"
    inference_route = 'ProteinProphet'
    protein_groups = "$TEST_DATA_DIR/ecoli_dia/metapipeline-ProteomicDIA/metapipeline-ProteomicDIA-1.4.0/ecoli_dia/main_workflow/validate-ProteomicPSM-2.4.1/ecoli_dia/ProteinProphet/output/ecoli_dia-ProteinProphet.idXML"
    library_tsv = "$TEST_DATA_DIR/ecoli_dia/metapipeline-ProteomicDIA/metapipeline-ProteomicDIA-1.4.0/ecoli_dia/main_workflow/generate-ProteomicSpectralLibrary-1.1.0/ecoli_dia/output/EasyPQP/ecoli_dia_library.tsv"
    export_summary_tsv = "$TEST_DATA_DIR/ecoli_dia/metapipeline-ProteomicDIA/metapipeline-ProteomicDIA-1.4.0/ecoli_dia/main_workflow/validate-ProteomicPSM-2.4.1/ecoli_dia/ProteinProphet/output/ecoli_dia-easypqp_export_summary.tsv"
    diann_report = "$TEST_DATA_DIR/ecoli_dia/metapipeline-ProteomicDIA/metapipeline-ProteomicDIA-1.4.0/ecoli_dia/main_workflow/quantitate-ProteomicDIA-1.3.0/ecoli_dia/output/DIA-NN/ecoli_dia-report.tsv"
}

params.mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.mzml_csv, 'ProteinProphet-mzml', launchDir)
params.search_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.search_idxml_csv, 'ProteinProphet-search', launchDir)
params.filtered_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.filtered_idxml_csv, 'ProteinProphet-filtered', launchDir)
params.psm_features_csv = csvEnvironmentExpander.prepareInputCsv(params.psm_features_csv, 'ProteinProphet-features', launchDir)

methods.setup()

process {
    echo = false
}
