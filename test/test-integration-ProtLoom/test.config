includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR is not set; configure it in .env')
}
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'DIA_QC_NFTEST'
    mzml_csv = "${projectDir}/test/test-integration-ProtLoom/mzml.csv"
    search_idxml_csv = "${projectDir}/test/test-integration-ProtLoom/search.csv"
    filtered_idxml_csv = "${projectDir}/test/test-integration-ProtLoom/filtered.csv"
    psm_features_csv = "${projectDir}/test/test-integration-ProtLoom/features.csv"
    inference_route = 'ProtLoom'
    protein_groups = "${projectDir}/test/test-integration-ProtLoom/groups.csv"
    library_tsv = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-ProtLoom/metapipeline-ProteomicDIA-1.2.0/ecoli_dia/main_workflow/generate-ProteomicSpectralLibrary-1.0.1/ecoli_dia/output/EasyPQP/ecoli_dia_library.tsv"
    export_summary_tsv = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-ProtLoom/metapipeline-ProteomicDIA-1.2.0/ecoli_dia/main_workflow/validate-ProteomicPSM-2.3.1/ecoli_dia/ProtLoom-0.2.3/output/ecoli_dia-easypqp_export_summary.tsv"
    diann_report = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-ProtLoom/metapipeline-ProteomicDIA-1.2.0/ecoli_dia/main_workflow/quantitate-ProteomicDIA-1.1.0/ecoli_dia/output/DIA-NN/ecoli_dia-report.tsv"
}

params.mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.mzml_csv, 'ProtLoom-mzml', launchDir)
params.search_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.search_idxml_csv, 'ProtLoom-search', launchDir)
params.filtered_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.filtered_idxml_csv, 'ProtLoom-filtered', launchDir)
params.psm_features_csv = csvEnvironmentExpander.prepareInputCsv(params.psm_features_csv, 'ProtLoom-features', launchDir)
params.protein_groups = csvEnvironmentExpander.prepareInputCsv(params.protein_groups, 'ProtLoom-groups', launchDir)

csvEnvironmentExpander.requireInputFiles(params.mzml_csv, 'path')
csvEnvironmentExpander.requireInputFiles(params.search_idxml_csv, 'idXML')
csvEnvironmentExpander.requireInputFiles(params.filtered_idxml_csv, 'idXML')
csvEnvironmentExpander.requireInputFiles(params.protein_groups, 'groups_tsv')
['library_tsv', 'export_summary_tsv', 'diann_report'].each { key ->
    if (!new File(params[key].toString()).isFile()) {
        throw new IllegalArgumentException("Missing ${key} input: ${params[key]}")
    }
}

methods.setup()

process {
    echo = false
}
