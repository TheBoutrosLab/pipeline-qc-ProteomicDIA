includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR is not set; configure it in .env')
}
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'hela_diapasef'
    mzml_csv = "${projectDir}/test/test-integration-HeLa-ProteinProphet/mzml.csv"
    search_idxml_csv = "${projectDir}/test/test-integration-HeLa-ProteinProphet/search.csv"
    filtered_idxml_csv = "${projectDir}/test/test-integration-HeLa-ProteinProphet/filtered.csv"
    psm_features_csv = "${projectDir}/test/test-integration-HeLa-ProteinProphet/features.csv"
    inference_route = 'ProteinProphet'
    protein_groups = "${TEST_DATA_DIR}/hela_diapasef/output/validate-ProteomicPSM/validate-ProteomicPSM-2.4.0/cohort/ProteinProphet/output/cohort-ProteinProphet.idXML"
    library_tsv = "${TEST_DATA_DIR}/hela_diapasef/output/generate-ProteomicSpectralLibrary/generate-ProteomicSpectralLibrary-1.0.1/hela_diapasef/output/EasyPQP/hela_diapasef_library.tsv"
    export_summary_tsv = "${TEST_DATA_DIR}/hela_diapasef/output/validate-ProteomicPSM/validate-ProteomicPSM-2.4.0/cohort/ProteinProphet/output/cohort-easypqp_export_summary.tsv"
    diann_report = "${TEST_DATA_DIR}/hela_diapasef/output/quantitate-ProteomicDIA/quantitate-ProteomicDIA-1.1.0/hela_diapasef/output/DIA-NN/hela_diapasef-report.tsv"
}

params.mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.mzml_csv, 'HeLa-ProteinProphet-mzml', launchDir)
params.search_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.search_idxml_csv, 'HeLa-ProteinProphet-search', launchDir)
params.filtered_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.filtered_idxml_csv, 'HeLa-ProteinProphet-filtered', launchDir)
params.psm_features_csv = csvEnvironmentExpander.prepareInputCsv(params.psm_features_csv, 'HeLa-ProteinProphet-features', launchDir)

csvEnvironmentExpander.requireInputFiles(params.mzml_csv, 'path')
csvEnvironmentExpander.requireInputFiles(params.mzml_csv, 'acquisition_path', true)
csvEnvironmentExpander.requireInputFiles(params.search_idxml_csv, 'idXML')
csvEnvironmentExpander.requireInputFiles(params.filtered_idxml_csv, 'idXML')
csvEnvironmentExpander.requireInputFiles(params.psm_features_csv, 'path')
['protein_groups', 'library_tsv', 'export_summary_tsv', 'diann_report'].each { key ->
    if (!new File(params[key].toString()).isFile()) {
        throw new IllegalArgumentException("Missing ${key} input: ${params[key]}")
    }
}
methods.setup()

process {
    echo = false
}
