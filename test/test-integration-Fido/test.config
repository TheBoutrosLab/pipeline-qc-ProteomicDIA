includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR is not set; configure it in .env')
}
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'DIA_QC_NFTEST'
    mzml_csv = "${projectDir}/test/test-integration-Fido/mzml.csv"
    search_idxml_csv = "${projectDir}/test/test-integration-Fido/search.csv"
    filtered_idxml_csv = "${projectDir}/test/test-integration-Fido/filtered.csv"
    inference_route = 'Fido'
    protein_groups = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-Fido/metapipeline-ProteomicDIA-1.0.0/ecoli_dia/main_workflow/validate-ProteomicPSM-2.2.2/ecoli_dia/Fido/output/ecoli_dia-Fido-groups.json"
    library_tsv = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-Fido/metapipeline-ProteomicDIA-1.0.0/ecoli_dia/main_workflow/generate-ProteomicSpectralLibrary-1.0.1/ecoli_dia/output/EasyPQP/ecoli_dia_library.tsv"
    export_summary_tsv = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-Fido/metapipeline-ProteomicDIA-1.0.0/ecoli_dia/main_workflow/validate-ProteomicPSM-2.2.2/ecoli_dia/Fido/output/ecoli_dia-easypqp_export_summary.tsv"
    diann_report = "${TEST_DATA_DIR}/ecoli_dia/metapipeline-ProteomicDIA-Fido/metapipeline-ProteomicDIA-1.0.0/ecoli_dia/main_workflow/quantitate-ProteomicDIA-1.1.0/ecoli_dia/output/DIA-NN/ecoli_dia-report.tsv"
}

params.mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.mzml_csv, 'Fido-mzml', launchDir)
params.search_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.search_idxml_csv, 'Fido-search', launchDir)
params.filtered_idxml_csv = csvEnvironmentExpander.prepareInputCsv(params.filtered_idxml_csv, 'Fido-filtered', launchDir)

methods.setup()

process {
    echo = false
}
