includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
params {
    dataset_id = 'cohort'
    mzml_csv = '/path/to/validation-mzml.csv'
    search_idxml_csv = '/path/to/validation.csv'
    filtered_idxml_csv = '/path/to/filtered-idxml.csv'
    inference_route = 'ProteinProphet'
    protein_groups = '/path/to/cohort-ProteinProphet.idXML'
    library_tsv = '/path/to/cohort_library.tsv'
    export_summary_tsv = '/path/to/cohort-easypqp_export_summary.tsv'
    diann_report = '/path/to/cohort-report.tsv'
    output_dir = '/path/to/output'
}
methods.setup()
