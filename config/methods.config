includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"

methods {
    set_output_and_log_dir = {
        def timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", TimeZone.getTimeZone('UTC'))
        params.output_dir_base = "${params.output_dir}/${manifest.name}-${manifest.version}/${params.dataset_id}"
        params.log_output_dir = "${params.output_dir_base}/log-${manifest.name}-${manifest.version}-${timestamp}"
    }
    set_pipeline_logs = {
        trace.enabled = true
        trace.file = "${params.log_output_dir}/nextflow-log/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.log_output_dir}/nextflow-log/timeline.html"
        report.enabled = true
        report.file = "${params.log_output_dir}/nextflow-log/report.html"
    }
    set_work_dir = {
        if (params.containsKey('work_dir') && params.work_dir) {
            schema.check_path(params.work_dir, 'w')
            workDir = params.work_dir
        } else {
            params.work_dir = System.getenv('NXF_WORK') ?: "${launchDir}/work"
        }
    }
    setup = {
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        if (!(params.dataset_id ==~ /[A-Za-z0-9][A-Za-z0-9._-]*/)) {
            throw new IllegalArgumentException('dataset_id must be a safe directory name')
        }
        ['mzml_csv', 'search_idxml_csv', 'filtered_idxml_csv', 'protein_groups',
         'library_tsv', 'export_summary_tsv'].each { name ->
            if (!new File(params[name].toString()).isFile()) {
                throw new IllegalArgumentException("Missing ${name}: ${params[name]}")
            }
        }
        if (!new File(params.diann_report.toString()).isFile()) {
            throw new IllegalArgumentException("Missing diann_report: ${params.diann_report}")
        }
        if (params.psm_features_csv && !new File(params.psm_features_csv.toString()).isFile()) {
            throw new IllegalArgumentException("Missing psm_features_csv: ${params.psm_features_csv}")
        }
        if (!(params.inference_route in ['ProteinProphet', 'Fido', 'Epifany', 'ProtLoom'])) {
            throw new IllegalArgumentException('Invalid inference_route')
        }
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_output_and_log_dir()
        methods.set_pipeline_logs()
        methods.set_work_dir()
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params,
            new File("${params.log_output_dir}/nextflow-log/params.json"))
    }
}
